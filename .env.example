# Sanity CMS Configuration
# Get these from https://sanity.io/manage
SANITY_PROJECT_ID=your_project_id_here
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_READ_TOKEN=optional_read_token_for_private_content

# Google Analytics
# Get your GA4 ID from https://analytics.google.com
PUBLIC_GA4_ID=G-XXXXXXXXXX

# Email Configuration
# Choose one email provider and configure accordingly

# Option 1: Resend (https://resend.com)
# Uncomment and configure if using Resend
# EMAIL_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=noreply@kunolapidary.com
# EMAIL_TO=info@kunolapidary.com

# Option 2: SendGrid (https://sendgrid.com)
# Uncomment and configure if using SendGrid
# EMAIL_API_KEY=SG.xxxxxxxxxxxx
# EMAIL_FROM=noreply@kunolapidary.com
# EMAIL_TO=info@kunolapidary.com

# Site Configuration
PUBLIC_SITE_URL=http://localhost:4321

# Rate Limiting (Production)
# For serverless deployment, use Vercel KV or Upstash Redis
# Vercel KV is automatically configured when added to your Vercel project
# KV_REST_API_URL=your_kv_url
# KV_REST_API_TOKEN=your_kv_token

# Upstash Redis (Alternative)
# UPSTASH_REDIS_REST_URL=your_upstash_url
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token

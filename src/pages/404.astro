---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import Button from '@/components/Button.astro';
---

<BaseLayout title="Page Not Found">
  <Section class="flex items-center justify-center min-h-[60vh]">
    <div class="text-center">
      <div class="mb-8">
        <span class="text-8xl md:text-9xl font-serif font-bold text-brand-tan">
          404
        </span>
      </div>
      <h1 class="text-3xl md:text-4xl font-serif font-bold text-gray-900 mb-4">
        Page Not Found
      </h1>
      <p class="text-lg text-gray-600 mb-8 max-w-md mx-auto">
        The page you're looking for seems to have been polished away. Let's get you back on track.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/">
          Return Home
        </Button>
        <Button href="/contact" variant="outline">
          Contact Us
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>

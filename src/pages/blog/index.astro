---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import PostCard from '@/components/PostCard.astro';
import Button from '@/components/Button.astro';
import { getAllPosts, getPostCount, getAllCategories, getAllTags } from '@/lib/sanity';

// Get current page from URL params
const currentPage = Number(Astro.url.searchParams.get('page')) || 1;
const postsPerPage = 9;
const offset = (currentPage - 1) * postsPerPage;

// Get selected filters from URL
const selectedCategory = Astro.url.searchParams.get('category') || undefined;
const selectedTag = Astro.url.searchParams.get('tag') || undefined;

// Build filters object
const filters = {
  category: selectedCategory,
  tag: selectedTag,
};

// Fetch data with filters
const [posts, totalCount, categories, tags] = await Promise.all([
  getAllPosts(postsPerPage, offset, filters),
  getPostCount(filters),
  getAllCategories(),
  getAllTags(),
]);

const totalPages = Math.ceil(totalCount / postsPerPage);
---

<BaseLayout title="Blog">
  <Section>
    <div class="max-w-7xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 mb-4 reveal-fade">
          Journal
        </h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto reveal-fade" style="transition-delay: 100ms;">
          Stories from our workshop, insights into our craft, and updates from the world of lapidary arts
        </p>
      </div>

      <div class="flex flex-col lg:flex-row gap-12">
        <!-- Sidebar -->
        <aside class="lg:w-1/4 space-y-8">
          <!-- Categories -->
          {categories && categories.length > 0 && (
            <div class="reveal-fade-up" style="transition-delay: 200ms;">
              <h3 class="font-serif text-xl font-semibold text-gray-900 mb-4">
                Categories
              </h3>
              <ul class="space-y-2">
                <li>
                  <a
                    href="/blog"
                    class={`block py-1 text-gray-600 hover:text-brand-blue transition-colors ${
                      !selectedCategory ? 'text-brand-blue font-medium' : ''
                    }`}
                  >
                    All Posts
                  </a>
                </li>
                {categories.map((category) => (
                  <li>
                    <a
                      href={`/blog?category=${category.slug}`}
                      class={`block py-1 text-gray-600 hover:text-brand-blue transition-colors ${
                        selectedCategory === category.slug ? 'text-brand-blue font-medium' : ''
                      }`}
                    >
                      {category.title}
                      {category.postCount > 0 && (
                        <span class="text-sm text-gray-400 ml-2">
                          ({category.postCount})
                        </span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Tags -->
          {tags && tags.length > 0 && (
            <div class="reveal-fade-up" style="transition-delay: 300ms;">
              <h3 class="font-serif text-xl font-semibold text-gray-900 mb-4">
                Popular Tags
              </h3>
              <div class="flex flex-wrap gap-2">
                {tags.slice(0, 15).map((tag) => (
                  <a
                    href={`/blog?tag=${tag.slug}`}
                    class={`inline-block px-3 py-1 text-sm rounded-full transition-colors ${
                      selectedTag === tag.slug
                        ? 'bg-brand-blue text-white'
                        : 'bg-gray-100 text-gray-600 hover:bg-brand-tan/20 hover:text-brand-brown'
                    }`}
                  >
                    {tag.title}
                  </a>
                ))}
              </div>
            </div>
          )}
        </aside>

        <!-- Posts Grid -->
        <div class="lg:w-3/4">
          {posts && posts.length > 0 ? (
            <>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {posts.map((post, index) => (
                  <div 
                    class="reveal-fade-up"
                    style={`transition-delay: ${200 + index * 50}ms;`}
                  >
                    <PostCard post={post} />
                  </div>
                ))}
              </div>

              <!-- Pagination -->
              {totalPages > 1 && (
                <div class="mt-12 flex justify-center">
                  <nav class="flex items-center space-x-2" aria-label="Pagination">
                    {currentPage > 1 && (
                      <Button
                        href={`/blog?page=${currentPage - 1}${selectedCategory ? `&category=${selectedCategory}` : ''}${selectedTag ? `&tag=${selectedTag}` : ''}`}
                        variant="outline"
                        size="sm"
                      >
                        Previous
                      </Button>
                    )}

                    <div class="flex items-center space-x-1">
                      {Array.from({ length: totalPages }, (_, i) => i + 1)
                        .filter(page =>
                          page === 1 ||
                          page === totalPages ||
                          Math.abs(page - currentPage) <= 2
                        )
                        .map((page, index, array) => (
                          <>
                            {index > 0 && array[index - 1] !== page - 1 && (
                              <span class="px-2 text-gray-400">...</span>
                            )}
                            <a
                              href={`/blog?page=${page}${selectedCategory ? `&category=${selectedCategory}` : ''}${selectedTag ? `&tag=${selectedTag}` : ''}`}
                              class={`px-3 py-1 rounded-md text-sm font-medium transition-colors ${
                                page === currentPage
                                  ? 'bg-brand-blue text-white'
                                  : 'text-gray-600 hover:bg-gray-100'
                              }`}
                              aria-current={page === currentPage ? 'page' : undefined}
                            >
                              {page}
                            </a>
                          </>
                        ))}
                    </div>

                    {currentPage < totalPages && (
                      <Button
                        href={`/blog?page=${currentPage + 1}${selectedCategory ? `&category=${selectedCategory}` : ''}${selectedTag ? `&tag=${selectedTag}` : ''}`}
                        variant="outline"
                        size="sm"
                      >
                        Next
                      </Button>
                    )}
                  </nav>
                </div>
              )}
            </>
          ) : (
            <div class="text-center py-12">
              <p class="text-gray-600 mb-4">No posts found.</p>
              <Button href="/" variant="outline">
                Return Home
              </Button>
            </div>
          )}
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>

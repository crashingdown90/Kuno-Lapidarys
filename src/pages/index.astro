---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import Button from '@/components/Button.astro';
import PostCard from '@/components/PostCard.astro';
import LapidaryCard from '@/components/LapidaryCard.astro';
import { getAllPosts, getFeaturedLapidarys, getFeaturedPartnerships } from '@/lib/sanity';

// Fetch data
const recentPosts = await getAllPosts(3);
const featuredLapidarys = await getFeaturedLapidarys();
const partnerships = await getFeaturedPartnerships();

const craftSteps = [
  {
    number: '01',
    title: 'Selection',
    description: 'Hand-picking the finest raw stones from trusted sources worldwide.',
  },
  {
    number: '02',
    title: 'Shaping',
    description: 'Precision cutting and forming using traditional and modern techniques.',
  },
  {
    number: '03',
    title: 'Polishing',
    description: 'Multiple stages of refinement to achieve perfect brilliance.',
  },
  {
    number: '04',
    title: 'Perfection',
    description: 'Final inspection ensuring each piece meets our exacting standards.',
  },
];
---

<BaseLayout>
  <!-- Hero Section -->
  <Section variant="default" size="xl" class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-tan/10 to-transparent"></div>
    <div class="relative z-10 text-center">
      <h1 class="text-5xl md:text-7xl font-serif font-bold text-brand-blue mb-4 reveal-fade-down">
        KUNO & Co.
      </h1>
      <p class="text-2xl md:text-3xl font-serif text-gray-700 mb-2 reveal-fade-down" style="transition-delay: 100ms;">
        Lapidary Works
      </p>
      <p class="text-lg md:text-xl text-gray-600 italic mb-8 reveal-fade-up" style="transition-delay: 200ms;">
        Born from Earth. Perfected by Hands.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center reveal-fade-up" style="transition-delay: 300ms;">
        <Button href="https://shop.kunolapidary.com" target="_blank" size="lg">
          Visit Our Shop
        </Button>
        <Button href="/lapidarys" variant="outline" size="lg">
          Meet Our Artisans
        </Button>
      </div>
    </div>
  </Section>

  <!-- Our Craft Section -->
  <Section variant="light" id="craft">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-gray-900 mb-4 reveal-fade">
        Our Craft Process
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto reveal-fade" style="transition-delay: 100ms;">
        Each piece undergoes a meticulous journey from raw stone to finished masterpiece
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {craftSteps.map((step, index) => (
        <div 
          class="text-center reveal-fade-up" 
          style={`transition-delay: ${200 + index * 100}ms;`}
        >
          <div class="w-20 h-20 mx-auto mb-4 flex items-center justify-center rounded-full bg-brand-tan/20 text-brand-brown">
            <span class="text-2xl font-serif font-bold">{step.number}</span>
          </div>
          <h3 class="text-xl font-serif font-semibold text-gray-900 mb-2">
            {step.title}
          </h3>
          <p class="text-gray-600">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Featured Lapidarys -->
  {featuredLapidarys && featuredLapidarys.length > 0 && (
    <Section variant="default">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-serif font-bold text-gray-900 mb-4 reveal-fade">
          Master Artisans
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto reveal-fade" style="transition-delay: 100ms;">
          Meet the skilled hands behind our exceptional creations
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">
        {featuredLapidarys.map((lapidary, index) => (
          <div 
            class="reveal-fade-up"
            style={`transition-delay: ${200 + index * 100}ms;`}
          >
            <LapidaryCard lapidary={lapidary} />
          </div>
        ))}
      </div>
      
      <div class="text-center">
        <Button href="/lapidarys" variant="outline">
          View All Artisans
        </Button>
      </div>
    </Section>
  )}

  <!-- Featured Journal/Blog -->
  {recentPosts && recentPosts.length > 0 && (
    <Section variant="tan">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-serif font-bold text-gray-900 mb-4 reveal-fade">
          Featured Journal
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto reveal-fade" style="transition-delay: 100ms;">
          Stories, insights, and updates from our workshop
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
        {recentPosts.map((post, index) => (
          <div 
            class="reveal-fade-up"
            style={`transition-delay: ${200 + index * 100}ms;`}
          >
            <PostCard post={post} />
          </div>
        ))}
      </div>
      
      <div class="text-center">
        <Button href="/blog">
          Read All Articles
        </Button>
      </div>
    </Section>
  )}

  <!-- Partnership Teaser -->
  <Section variant="default">
    <div class="bg-gradient-to-r from-brand-blue to-brand-blue/90 rounded-2xl p-12 text-white text-center reveal-scale">
      <h2 class="text-3xl md:text-4xl font-serif font-bold mb-4">
        Partner With Us
      </h2>
      <p class="text-lg mb-8 max-w-2xl mx-auto opacity-90">
        Join our network of galleries, designers, and retailers bringing exceptional lapidary art to the world
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/partnership" variant="secondary" size="lg">
          Learn More
        </Button>
        <Button href="/contact" variant="outline" size="lg" class="!text-white !border-white hover:!bg-white hover:!text-brand-blue">
          Get in Touch
        </Button>
      </div>
    </div>
  </Section>

  <!-- Social Strip -->
  <Section variant="light" size="sm">
    <div class="text-center">
      <p class="text-sm font-sans uppercase tracking-wider text-gray-500 mb-4">
        Follow Our Journey
      </p>
      <div class="flex justify-center space-x-6">
        <a
          href="https://instagram.com/kunolapidary"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-400 hover:text-brand-blue transition-colors"
          aria-label="Instagram"
        >
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1112.324 0 6.162 6.162 0 01-12.324 0zM12 16a4 4 0 110-8 4 4 0 010 8zm4.965-10.405a1.44 1.44 0 112.881.001 1.44 1.44 0 01-2.881-.001z"/>
          </svg>
        </a>
        <a
          href="https://tiktok.com/@kunolapidary"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-400 hover:text-brand-blue transition-colors"
          aria-label="TikTok"
        >
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.34 6.34 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/>
          </svg>
        </a>
        <a
          href="https://youtube.com/@kunolapidary"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-400 hover:text-brand-blue transition-colors"
          aria-label="YouTube"
        >
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </a>
      </div>
    </div>
  </Section>
</BaseLayout>

---
export interface Props {
  variant?: 'default' | 'light' | 'dark' | 'tan';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  container?: boolean;
  class?: string;
  id?: string;
}

const {
  variant = 'default',
  size = 'lg',
  container = true,
  class: className = '',
  id,
} = Astro.props;

const variantClasses = {
  default: 'bg-white',
  light: 'bg-gray-50',
  dark: 'bg-brand-blue text-white',
  tan: 'bg-brand-tan/10',
};

const sizeClasses = {
  sm: 'py-8 md:py-12',
  md: 'py-12 md:py-16',
  lg: 'py-16 md:py-24',
  xl: 'py-20 md:py-32',
};

const sectionClasses = `${variantClasses[variant]} ${sizeClasses[size]} ${className}`;
---

<section id={id} class={sectionClasses}>
  {container ? (
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <slot />
    </div>
  ) : (
    <slot />
  )}
</section>

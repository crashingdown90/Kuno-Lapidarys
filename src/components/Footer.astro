---
import type { SiteSettings } from '@/types/sanity';

export interface Props {
  siteSettings: SiteSettings | null;
}

const { siteSettings } = Astro.props;
const currentYear = new Date().getFullYear();

const footerLinks = [
  {
    title: 'Explore',
    links: [
      { label: 'About Us', href: '/about' },
      { label: 'Our Lapidarys', href: '/lapidarys' },
      { label: 'Partnership', href: '/partnership' },
      { label: 'Blog', href: '/blog' },
    ],
  },
  {
    title: 'Support',
    links: [
      { label: 'Contact Us', href: '/contact' },
      { label: 'Shop', href: 'https://shop.kunolapidary.com', external: true },
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'Terms of Service', href: '/terms' },
    ],
  },
];
---

<footer class="bg-gray-50 border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand Column -->
      <div class="col-span-1 md:col-span-2">
        <div class="mb-4">
          <h3 class="font-serif text-2xl font-bold text-brand-blue">
            KUNO & Co. Lapidary Works
          </h3>
          {siteSettings?.tagline && (
            <p class="mt-2 text-sm text-gray-600 italic">
              {siteSettings.tagline}
            </p>
          )}
        </div>
        
        <!-- Social Links -->
        {siteSettings?.socialLinks && (
          <div class="flex space-x-4 mt-6">
            {siteSettings.socialLinks.instagram && (
              <a
                href={siteSettings.socialLinks.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-500 hover:text-brand-blue transition-colors"
                aria-label="Instagram"
              >
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1112.324 0 6.162 6.162 0 01-12.324 0zM12 16a4 4 0 110-8 4 4 0 010 8zm4.965-10.405a1.44 1.44 0 112.881.001 1.44 1.44 0 01-2.881-.001z"/>
                </svg>
              </a>
            )}
            {siteSettings.socialLinks.tiktok && (
              <a
                href={siteSettings.socialLinks.tiktok}
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-500 hover:text-brand-blue transition-colors"
                aria-label="TikTok"
              >
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.34 6.34 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/>
                </svg>
              </a>
            )}
            {siteSettings.socialLinks.youtube && (
              <a
                href={siteSettings.socialLinks.youtube}
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-500 hover:text-brand-blue transition-colors"
                aria-label="YouTube"
              >
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              </a>
            )}
          </div>
        )}
      </div>
      
      <!-- Links Columns -->
      {footerLinks.map((section) => (
        <div class="col-span-1">
          <h4 class="font-sans text-sm font-semibold text-gray-900 uppercase tracking-wider mb-4">
            {section.title}
          </h4>
          <ul class="space-y-2">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  class="text-gray-600 hover:text-brand-blue text-sm transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    
    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-gray-200">
      <p class="text-center text-sm text-gray-500">
        {siteSettings?.copyrightText || `© ${currentYear} KUNO & Co. Lapidary Works. All rights reserved.`}
      </p>
    </div>
  </div>
</footer>

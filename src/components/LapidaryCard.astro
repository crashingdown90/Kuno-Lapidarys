---
import type { Lapidary } from '@/types/sanity';
import { urlFor } from '@/lib/sanity';

export interface Props {
  lapidary: Lapidary;
}

const { lapidary } = Astro.props;

const portraitUrl = lapidary.portrait
  ? urlFor(lapidary.portrait).width(400).height(500).url()
  : '/placeholder-portrait.jpg';
---

<article class="group">
  <a href={`/lapidarys/${lapidary.slug}`} class="block">
    <div class="relative overflow-hidden rounded-lg bg-gray-50 aspect-[4/5]">
      <img
        src={portraitUrl}
        alt={lapidary.portrait?.alt || lapidary.name}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/0 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
    </div>
    <div class="mt-4 text-center">
      <h3 class="font-serif text-xl font-semibold text-gray-900 group-hover:text-brand-blue transition-colors">
        {lapidary.name}
      </h3>
      {lapidary.role && (
        <p class="mt-1 text-sm text-gray-600">
          {lapidary.role}
        </p>
      )}
      {lapidary.skills && lapidary.skills.length > 0 && (
        <div class="mt-3 flex flex-wrap justify-center gap-2">
          {lapidary.skills.slice(0, 3).map((skill) => (
            <span class="inline-block px-2 py-1 text-xs font-medium text-brand-brown bg-brand-tan/30 rounded-full">
              {skill}
            </span>
          ))}
        </div>
      )}
    </div>
  </a>
</article>

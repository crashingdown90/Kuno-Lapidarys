---
interface Props {
  name: string;
  role: string;
  text: string;
  rating?: number;
  image?: string;
  project?: string;
}

const { name, role, text, rating = 5, image, project } = Astro.props;
---

<div class="bg-white rounded-lg p-8 shadow-md hover:shadow-xl transition-shadow duration-300">
  <!-- Rating Stars -->
  {rating && (
    <div class="flex gap-1 mb-4">
      {Array.from({ length: 5 }, (_, i) => (
        <svg
          class={`w-5 h-5 ${i < rating ? 'text-yellow-400' : 'text-gray-300'}`}
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
      ))}
    </div>
  )}

  <!-- Testimonial Text -->
  <blockquote class="mb-6">
    <p class="text-gray-700 italic leading-relaxed">
      "{text}"
    </p>
  </blockquote>

  <!-- Author Info -->
  <div class="flex items-center gap-4 pt-4 border-t border-gray-100">
    {image ? (
      <img
        src={image}
        alt={name}
        class="w-12 h-12 rounded-full object-cover"
      />
    ) : (
      <div class="w-12 h-12 rounded-full bg-brand-tan/30 flex items-center justify-center">
        <span class="text-brand-brown font-semibold text-lg">
          {name.charAt(0)}
        </span>
      </div>
    )}

    <div class="flex-1">
      <div class="font-semibold text-gray-900">{name}</div>
      <div class="text-sm text-gray-600">{role}</div>
      {project && (
        <div class="text-xs text-brand-brown mt-1">
          Project: {project}
        </div>
      )}
    </div>
  </div>
</div>
